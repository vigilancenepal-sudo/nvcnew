{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "National Vigilance Centre staff user profile and RBAC assignment",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "designation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "mahashakha", "shakha"]
        },
        "mahashakhaId": {
          "type": "string",
          "maxLength": 64
        },
        "shakhaId": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "fullName", "designation", "role", "mahashakhaId", "shakhaId", "status", "createdAt", "updatedAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Complaint record registered at National Vigilance Centre",
      "type": "object",
      "properties": {
        "dartaNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "complainant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "enum": ["hello_sarkar", "online", "hotline", "kendra_darta"]
        },
        "ministry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "nature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["chalu", "farchhaut", "patrachar_baki", "chhanbin_ma", "kam_baki"]
        },
        "districtEn": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "fiscalYear": {
          "type": "string",
          "enum": ["2083/84", "2082/83", "2081/82"]
        },
        "monthIndex": {
          "type": "number"
        },
        "nepaliDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "mahashakhaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "shakhaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "dartaNo",
        "title",
        "complainant",
        "source",
        "ministry",
        "nature",
        "status",
        "districtEn",
        "fiscalYear",
        "monthIndex",
        "nepaliDate",
        "mahashakhaId",
        "shakhaId",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "Operational records for office monitoring, investigation, technical audit, project monitoring, sample reports, and promotional programs",
      "type": "object",
      "properties": {
        "refNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "activityType": {
          "type": "string",
          "enum": [
            "karyalaya_anugaman",
            "badapatra_anugaman",
            "chhanbin_anveshan",
            "prabidhik_parikshan",
            "aayojana_anugaman",
            "namuna_parikshan",
            "prabardhanatmak",
            "suchana_prakashan"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "entityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "districtEn": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "fiscalYear": {
          "type": "string",
          "enum": ["2083/84", "2082/83", "2081/82"]
        },
        "monthIndex": {
          "type": "number"
        },
        "nepaliDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "nonComplianceCount": {
          "type": "number"
        },
        "directiveCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["sampanna", "chalu", "pratibedan_pesh"]
        },
        "mahashakhaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "shakhaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "refNo",
        "activityType",
        "title",
        "entityName",
        "districtEn",
        "fiscalYear",
        "monthIndex",
        "nepaliDate",
        "nonComplianceCount",
        "directiveCount",
        "status",
        "mahashakhaId",
        "shakhaId",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Staff user accounts with role, mahashakhaId, shakhaId, and active status"
    },
    "/complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Complaints scoped by mahashakhaId and shakhaId"
    },
    "/activities/{activityId}": {
      "schema": "ActivityRecord",
      "description": "Monitoring, investigation, technical audit, project monitoring, and lab sample records"
    }
  }
}
